# Express server (Server_/server.js)
# PORT is set automatically by most hosts (e.g. Render) - only set it locally if you need a non-default port.
# PORT=5000

# Full predict URL of the deployed Flask ML service.
# Local dev default (if unset): http://127.0.0.1:5001/predict
FLASK_PREDICT_URL=https://your-flask-service.onrender.com/predict

# Origin of the deployed React app, for CORS.
# Local dev default (if unset): http://localhost:5173
CLIENT_ORIGIN=https://your-frontend.vercel.app
